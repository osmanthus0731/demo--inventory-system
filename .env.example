# Use a separate MongoDB Atlas database and a database user restricted to it.
DEMO_MONGO_URI=mongodb+srv://DEMO_USER:DEMO_PASSWORD@YOUR_CLUSTER.mongodb.net/
DEMO_MONGO_DB=meadow_demo
# Generate once with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep the same value across deployments and function instances.
FLASK_SECRET=
